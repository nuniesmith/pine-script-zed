indicator("RubyIndicator", shorttitle="RubyI", overlay=true,
     max_boxes_count=100, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 0. OPTIMIZER CONSTANTS  ← paste ruby_optimizer.py output block here
// ══════════════════════════════════════════════════════════════════════════════
var float OPT_VOL_MULT_LO   = 0.80
var float OPT_VOL_MULT_MED  = 1.20
var float OPT_VOL_MULT_HI   = 1.80
var float OPT_QUAL_TREND    = 60.0
var float OPT_QUAL_RANGE    = 48.0
var float OPT_QUAL_VOLATILE = 44.0
var int   OPT_CD_MIN        = 8
var int   OPT_CD_MAX        = 30
var float OPT_TP1_BASE      = 1.5
var float OPT_TP2_BASE      = 2.5
var float OPT_TP3_BASE      = 4.0
var float OPT_RSI_OB_TREND  = 70.0
var float OPT_RSI_OB_RANGE  = 63.0
var float OPT_RSI_OS_TREND  = 30.0
var float OPT_RSI_OS_RANGE  = 37.0
var float OPT_WAVE_PCT_L    = 25.0
var float OPT_WAVE_PCT_S    = 75.0
var float OPT_MOM_PCT       = 30.0

OPT_VOL_MULT_LO   := math.max(0.3,               math.min(2.0,   OPT_VOL_MULT_LO))
OPT_VOL_MULT_MED  := math.max(OPT_VOL_MULT_LO,   math.min(3.0,   OPT_VOL_MULT_MED))
OPT_VOL_MULT_HI   := math.max(OPT_VOL_MULT_MED,  math.min(5.0,   OPT_VOL_MULT_HI))
OPT_QUAL_TREND    := math.max(0.0,               math.min(100.0, OPT_QUAL_TREND))
OPT_QUAL_RANGE    := math.max(0.0,               math.min(100.0, OPT_QUAL_RANGE))
OPT_QUAL_VOLATILE := math.max(0.0,               math.min(100.0, OPT_QUAL_VOLATILE))
OPT_CD_MIN        := math.max(1,                  math.min(99,    OPT_CD_MIN))
OPT_CD_MAX        := math.max(OPT_CD_MIN + 1,     math.min(200,   OPT_CD_MAX))
OPT_TP1_BASE      := math.max(0.5,               math.min(5.0,   OPT_TP1_BASE))
OPT_TP2_BASE      := math.max(OPT_TP1_BASE,       math.min(10.0,  OPT_TP2_BASE))
OPT_TP3_BASE      := math.max(OPT_TP2_BASE,       math.min(20.0,  OPT_TP3_BASE))
OPT_RSI_OB_TREND  := math.max(50.0,              math.min(95.0,  OPT_RSI_OB_TREND))
OPT_RSI_OB_RANGE  := math.max(50.0,              math.min(90.0,  OPT_RSI_OB_RANGE))
OPT_RSI_OS_TREND  := math.max(5.0,               math.min(50.0,  OPT_RSI_OS_TREND))
OPT_RSI_OS_RANGE  := math.max(10.0,              math.min(50.0,  OPT_RSI_OS_RANGE))
OPT_WAVE_PCT_L    := math.max(0.0,               math.min(100.0, OPT_WAVE_PCT_L))
OPT_WAVE_PCT_S    := math.max(0.0,               math.min(100.0, OPT_WAVE_PCT_S))
OPT_MOM_PCT       := math.max(0.0,               math.min(100.0, OPT_MOM_PCT))

// ══════════════════════════════════════════════════════════════════════════════
// 0b. UTILITY FUNCTIONS + EARLY GLOBAL DECLARATIONS
// ══════════════════════════════════════════════════════════════════════════════

f_clamp(v, lo, hi) => math.max(lo, math.min(hi, v))

f_pct(arr, val) =>
    n = array.size(arr)
    if n == 0
        0.5
    else
        cnt = 0
        for i = 0 to n - 1
            if array.get(arr, i) < val
                cnt += 1
        float(cnt) / float(n)

var array<label> label_pool   = array.new<label>()
int              MAX_LBL_POOL = 450

f_label_new(lx, ly, ltxt, lcol, lsty, ltcol, ltsz) =>
    lbl = label.new(lx, ly, ltxt, color=lcol, style=lsty, textcolor=ltcol, size=ltsz)
    array.push(label_pool, lbl)
    if array.size(label_pool) > MAX_LBL_POOL
        label.delete(array.shift(label_pool))
    lbl

// ══════════════════════════════════════════════════════════════════════════════
// 1. SETTINGS
// ══════════════════════════════════════════════════════════════════════════════

var g1 = "⚙️ Strategy"
biasMode    = input.string("Auto", "Session Bias",
     options=["Auto","Long Only","Short Only"], group=g1)
requireVWAP = input.bool(true, "Require VWAP Alignment", group=g1)
orbMinutes  = input.int(5, "ORB Minutes", minval=1, maxval=120, group=g1)
htfTF       = input.string("3", "HTF Timeframe",
     options=["3","5","10","15","30","60"], group=g1)
ibMinutes   = input.int(60, "IB Minutes", minval=15, maxval=480, group=g1)
useHTFAO    = input.bool(false, "Require HTF AO Confirmation",
     tooltip="Long signals require HTF AO > 0; shorts require HTF AO < 0.", group=g1)

// ── Session sub-group
var gS = "⚙️ Strategy — Session"
autoSession      = input.bool(true, "Auto-Detect Session (recommended)",
     tooltip="Detects asset type (futures/forex/crypto/equity) and sets " +
             "session hours, ORB window, and session filter automatically. " +
             "Turn OFF to use the manual overrides below.", group=gS)
sessionHours     = input.string("0930-1600", "Manual Session Hours (RTH)",
     tooltip="Used only when Auto-Detect is OFF.\n" +
             "Set 0000-0000 for 24/7 assets.", group=gS)
useSession       = input.bool(true,  "Manual Use Session Filter",
     tooltip="Used only when Auto-Detect is OFF.\n" +
             "Disable for crypto, FX.", group=gS)
orbWindowSession = input.string("0930-1000", "Manual ORB Window Session",
     tooltip="Used only when Auto-Detect is OFF.\n" +
             "Default = NYSE open. Crypto: try 0000-0030.", group=gS)

var g2 = "📊 Top G Channel"
topGLen            = input.int(50,    "Channel Length",     minval=10,                    group=g2)
showMid            = input.bool(true, "Show Mid Line",                                    group=g2)
sigSens            = input.float(0.5, "Signal Sensitivity", minval=0.1, maxval=2.0, step=0.1, group=g2,
     tooltip="One knob that scales TG proximity, momentum, and wave gates together.")
showTGDots         = input.bool(true,  "Show Strong TG Dots",                             group=g2)
showSimpleDots     = input.bool(true,  "Show Simple Touch Dots",                          group=g2)
showPotDots        = input.bool(false, "Show Potential Zone Dots",                        group=g2)
showBreakoutLabels = input.bool(true,  "Show Breakout Entry Labels",                      group=g2)
suppressRegime     = input.bool(false, "Suppress Counter-Trend Signals",                  group=g2,
     tooltip="Blocks longs in TRENDING ↓ and shorts in TRENDING ↑.")
filterORBQuality   = input.bool(true,  "Gate ORB/RB on Quality + Wave",                  group=g2)

var g3 = "🎨 Display"
useVolHeat       = input.bool(true, "Volume Heat Bars", group=g_disp)
showVWAP        = input.bool(true,  "Show VWAP",         group=g3)
showEMA9        = input.bool(true,  "Show EMA9",         group=g3)
showDash        = input.bool(true,  "Show Dashboard",    group=g3)
showEntryLabels = input.bool(true,  "Show Entry Labels", group=g3)
dashPos_str     = input.string("Top Right", "Dashboard Position",
     options=["Top Right","Bottom Right","Top Left","Bottom Left"], group=g3)
maxLabelsDay    = input.int(6,     "Max Labels Per Day", minval=2, maxval=30, group=g3)
minLabelDistATR = input.float(1.5, "Min Label Spacing (ATR x)", minval=0.5, step=0.25, group=g3)

var g5 = "📐 Position Management"
dynSL        = input.bool(true,  "Dynamic SL (vol + sweep)",     group=g5)
sweepBars    = input.int(8,      "Stop Hunt Lookback (bars)",    minval=3, maxval=20, group=g5)
slVolBoost   = input.bool(true,  "Widen SL on Volume Surges",    group=g5)
showTrail    = input.bool(true,  "Show Trailing Stop",           group=g5)
showScaleIn  = input.bool(true,  "Show Scale-In Levels (E2/E3)", group=g5)

var g4 = "📈 Trade Tracker"
showTracker    = input.bool(true,  "Show Trade Tracker",         group=g4)
trackerPos_str = input.string("Bottom Right", "Tracker Position",
     options=["Top Right","Bottom Right","Top Left","Bottom Left"], group=g4)
resetOnDay     = input.bool(false, "Reset Stats Each Session Day", group=g4)
winTarget      = input.string("TP1", "Win = Hit",
     options=["TP1","TP2","TP3"], group=g4)

// ══════════════════════════════════════════════════════════════════════════════
// 1b. AUTO SESSION DETECTION
//
// Reads syminfo.type once per bar (it's a constant) and derives three
// effective session parameters that replace the manual inputs when
// autoSession is ON.
//
// syminfo.type values used:
//   "crypto"  — 24/7 cryptocurrency
//   "forex"   — spot FX pairs
//   "futures" — futures contracts (CME, CBOT, NYMEX, etc.)
//   "stock"   — equities
//   "fund"    — ETFs and mutual funds
//   "dr"      — depositary receipts (ADRs, GDRs)
//   "index"   — cash indices
//   other     — bonds, spreads, economic — treated as equity-style
//
// Notes on futures session string:
//   "0930-1600" covers CME equity-index RTH (ES, NQ, RTY).
//   For energy (CL "0900-1430"), metals (GC "0830-1330"), or rates,
//   turn autoSession OFF and enter the correct session manually.
// ══════════════════════════════════════════════════════════════════════════════

bool _type_crypto  = syminfo.type == "crypto"
bool _type_forex   = syminfo.type == "forex"
bool _type_futures = syminfo.type == "futures"
bool _type_equity  = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
bool _type_index   = syminfo.type == "index"
// Any unrecognised type falls through to the equity-style defaults below.

// Short label shown in the dashboard
string asset_type_label = _type_crypto  ? "crypto"  :
                          _type_forex   ? "forex"   :
                          _type_futures ? "futures" :
                          _type_equity  ? "equity"  :
                          _type_index   ? "index"   : "other"

// Auto-derived session parameters
string _auto_session_hours = _type_crypto or _type_forex ? "0000-0000" : "0930-1600"

bool   _auto_use_session   = not (_type_crypto or _type_forex)

// ORB window by type:
//   crypto  → midnight-open volatility window
//   forex   → New York open (main liquidity event)
//   futures → first 5 min of RTH (tight, equity-index default)
//   equity / index / other → first 30 min of RTH
string _auto_orb_window = _type_crypto  ? "0000-0030" :
                          _type_forex   ? "1300-1330" :
                          _type_futures ? "0930-0935" : "0930-1000"

// Resolve effective values — auto overrides manual inputs when autoSession=ON
string _eff_session_hours = autoSession ? _auto_session_hours : sessionHours
bool   _eff_use_session   = autoSession ? _auto_use_session   : useSession
string _eff_orb_window    = autoSession ? _auto_orb_window    : orbWindowSession

// ══════════════════════════════════════════════════════════════════════════════
// 2. CORE INDICATORS
// ══════════════════════════════════════════════════════════════════════════════
ema9   = ta.ema(close, 9)
atr14  = ta.atr(14)
volAvg = ta.sma(volume, 20)
ao     = ta.sma(hl2, 5) - ta.sma(hl2, 34)
rsi14  = ta.rsi(close, 14)

_vwap_raw  = ta.vwap(hlc3)
_vwap_sma  = ta.sma(close, 20)
vwap       = na(_vwap_raw) ? _vwap_sma : _vwap_raw
vwap_valid = not na(_vwap_raw)

// ══════════════════════════════════════════════════════════════════════════════
// 3. TOP G CHANNEL
// ══════════════════════════════════════════════════════════════════════════════
tg_lo    = ta.lowest (low,  topGLen)
tg_hi    = ta.highest(high, topGLen)
tg_mid   = ta.hma(math.avg(tg_lo, tg_hi), 15)
tg_range = tg_hi - tg_lo

roc8     = ta.roc(close, 8)
roc8_std = ta.stdev(roc8, 200)
roc_norm = roc8_std > 0 ? roc8 / roc8_std : 0.0
_tg_prox = atr14 * 0.2 * sigSens

strong_bot = low[1]  <= tg_lo[1] + _tg_prox and low  > tg_lo[1] and
             low[2]  <= tg_lo[2] + _tg_prox and
             roc_norm[2] < -2 * sigSens and barstate.isconfirmed

strong_top = high[1] >= tg_hi[1] - _tg_prox and high < tg_hi[1] and
             high[2]  >= tg_hi[2] - _tg_prox and
             roc_norm[2] > 2 * sigSens and barstate.isconfirmed

simple_bot = low[1]  <= tg_lo[1] + _tg_prox and low  > tg_lo[1] and not strong_bot and barstate.isconfirmed
simple_top = high[1] >= tg_hi[1] - _tg_prox and high < tg_hi[1] and not strong_top and barstate.isconfirmed

bool pot_bot = low  <= tg_lo + atr14 * 0.5 and roc_norm < -1 * sigSens and barstate.isconfirmed
bool pot_top = high >= tg_hi - atr14 * 0.5 and roc_norm >  1 * sigSens and barstate.isconfirmed

// ══════════════════════════════════════════════════════════════════════════════
// 4. WAVE ANALYSIS
// ══════════════════════════════════════════════════════════════════════════════
dyn_ema = ta.ema(close, 20)

var float speed = 0.0
c_rma = ta.rma(close, 10)
o_rma = ta.rma(open,  10)

var int          wx1              = na
var array<float> bull_waves       = array.new<float>()
var array<float> bear_waves       = array.new<float>()
var bool         any_wave_crossed = false

int   wave_lkbk = math.max(1, bar_index - nz(wx1, bar_index))
float speed_lo  = ta.lowest( speed, wave_lkbk)
float speed_hi  = ta.highest(speed, wave_lkbk)

any_wave_crossed := false

if close > dyn_ema and close[1] <= dyn_ema
    array.push(bear_waves, speed_lo)
    if array.size(bear_waves) > 200
        array.shift(bear_waves)
    wx1              := bar_index
    speed            := c_rma - o_rma
    any_wave_crossed := true
else if close < dyn_ema and close[1] >= dyn_ema
    array.push(bull_waves, speed_hi)
    if array.size(bull_waves) > 200
        array.shift(bull_waves)
    wx1              := bar_index
    speed            := c_rma - o_rma
    any_wave_crossed := true
else
    speed := speed + (c_rma - o_rma)

var float  wave_ratio = 1.0
var float  dom_val    = 0.0
var string mkt_bias   = "Neutral"
var float  bull_avg   = 0.0001
var float  bear_avg_v = 0.0001

if barstate.isconfirmed
    if array.size(bull_waves) > 0
        bull_avg := array.avg(bull_waves)
    if array.size(bear_waves) > 0
        bear_avg_v := math.abs(array.avg(bear_waves))
    wave_ratio := bear_avg_v == 0 ? 1.0 : bull_avg / bear_avg_v
    dom_val    := bull_avg - bear_avg_v
    mkt_bias   := dom_val > 0 ? "Bullish" : dom_val < 0 ? "Bearish" : "Neutral"

cur_ratio = speed > 0
     ? (bull_avg   > 0 ? speed           / bull_avg   :  1.0)
     : (bear_avg_v > 0 ? math.abs(speed) / bear_avg_v * -1.0 : -1.0)

// wr_arr cold-start fix: seed the lower half with 0.5 so f_pct() returns ~0.5
// (neutral) on bar 0 instead of 0.0, which would block waveOK_L for 200+ crossings.
var array<float> wr_arr  = array.new<float>(200, 1.0)
var array<float> mom_arr = array.new<float>(200, 0.5)
var bool _wr_seeded = false
if not _wr_seeded
    for _i = 0 to 99
        array.set(wr_arr, _i, 0.5)
    _wr_seeded := true

if barstate.isconfirmed and any_wave_crossed
    array.push(wr_arr,  nz(wave_ratio, 1.0))
    array.push(mom_arr, nz(math.abs(cur_ratio), 0.5))
    if array.size(wr_arr)  > 200
        array.shift(wr_arr)
    if array.size(mom_arr) > 200
        array.shift(mom_arr)

var float wr_pct  = 0.5
var float mom_pct = 0.5

if barstate.isconfirmed
    wr_pct  := f_pct(wr_arr,  nz(wave_ratio, 1.0))
    mom_pct := f_pct(mom_arr, nz(math.abs(cur_ratio), 0.5))

// ══════════════════════════════════════════════════════════════════════════════
// 5. MARKET REGIME + PHASE
// ══════════════════════════════════════════════════════════════════════════════
ma_200  = ta.sma(close, 200)
avg_chg = ta.sma(math.abs(ta.change(ma_200)), 100)
slope_n = avg_chg == 0 ? 0.0 : (ma_200 - nz(ma_200[20], ma_200)) / (avg_chg * 20)
ret_s   = ta.stdev(ta.change(close) / nz(close[1], close), 100)
ret_sma = ta.sma(ret_s, 50)
vol_n   = ret_sma == 0 ? 1.0 : ret_s / ret_sma

market_regime  = slope_n >  1.0 ? "TRENDING ↑" :
                 slope_n < -1.0 ? "TRENDING ↓" :
                 vol_n   >  1.5 ? "VOLATILE"   :
                 vol_n   <  0.8 ? "RANGING"    : "NEUTRAL"

bool is_trending   = market_regime == "TRENDING ↑" or market_regime == "TRENDING ↓"
bool is_trending_u = market_regime == "TRENDING ↑"
bool is_trending_d = market_regime == "TRENDING ↓"
bool is_ranging    = market_regime == "RANGING"
bool is_volatile   = market_regime == "VOLATILE"

var string market_phase = "NEUTRAL"
var color  phase_col    = color.gray

bool uptrend_cross = ta.crossover(close,  tg_hi[10])
bool dntrend_cross = ta.crossunder(close, tg_lo[10])

if barstate.isconfirmed
    if uptrend_cross and ao > 0
        market_phase := "UPTREND"
        phase_col    := color.lime
    else if dntrend_cross and ao < 0
        market_phase := "DOWNTREND"
        phase_col    := color.red
    else if close > tg_hi[5] and close < tg_hi and ao > 0 and ao < ao[10]
        market_phase := "DISTRIB"
        phase_col    := color.orange
    else if close < tg_lo[5] and close > tg_lo and ao < 0 and ao > ao[10]
        market_phase := "ACCUM"
        phase_col    := color.yellow

// ══════════════════════════════════════════════════════════════════════════════
// 6. VOLATILITY PERCENTILE
// ══════════════════════════════════════════════════════════════════════════════
var array<float> vol_arr = array.new<float>(200, 0.0)

if barstate.isconfirmed
    array.push(vol_arr, nz(atr14, 0.0))
    if array.size(vol_arr) > 200
        array.shift(vol_arr)

var float vol_pct = 0.5

if barstate.isconfirmed
    vol_pct := f_pct(vol_arr, nz(atr14, 0.0))

vol_regime = vol_pct >= 0.8 ? "VERY HIGH" :
             vol_pct >= 0.6 ? "HIGH"      :
             vol_pct <= 0.2 ? "VERY LOW"  :
             vol_pct <= 0.4 ? "LOW"       : "MED"

// ══════════════════════════════════════════════════════════════════════════════
// 7. ADAPTIVE THRESHOLDS
// ══════════════════════════════════════════════════════════════════════════════
float volMult = vol_pct >= 0.6 ? OPT_VOL_MULT_HI :
                 vol_pct >= 0.4 ? OPT_VOL_MULT_MED : OPT_VOL_MULT_LO

float minQualityPct = is_trending ? OPT_QUAL_TREND :
                      is_volatile ? OPT_QUAL_VOLATILE : OPT_QUAL_RANGE

int cooldownBars = math.round(OPT_CD_MIN + (OPT_CD_MAX - OPT_CD_MIN) * vol_pct)

float rsiOBLevel = is_trending_u ? OPT_RSI_OB_TREND : OPT_RSI_OB_RANGE
float rsiOSLevel = is_trending_d ? OPT_RSI_OS_TREND : OPT_RSI_OS_RANGE

bool waveOK_L = wr_pct >= f_clamp((OPT_WAVE_PCT_L / 100.0) * sigSens, 0.01, 0.99)
bool waveOK_S = wr_pct <= f_clamp(1.0 - (OPT_WAVE_PCT_S / 100.0), 0.01, 0.99)  // sigSens removed: was permanently blocking shorts on bullish assets

bool momOK_L = mom_pct >= f_clamp((OPT_MOM_PCT / 100.0) * sigSens, 0.01, 0.99) and cur_ratio > 0
bool momOK_S = mom_pct >= f_clamp((OPT_MOM_PCT / 100.0) * sigSens, 0.01, 0.99) and cur_ratio < 0

float _tp_mom_scale = math.abs(cur_ratio) >= 1.5 ? 1.25 :
                      math.abs(cur_ratio) >= 1.0 ? 1.0  :
                      math.abs(cur_ratio) >= 0.6 ? 0.85 : 0.7
float _tp_scale = _tp_mom_scale * (0.7 + sigSens * 0.6)

float tp1R = OPT_TP1_BASE * _tp_scale
float tp2R = OPT_TP2_BASE * _tp_scale
float tp3R = OPT_TP3_BASE * _tp_scale

float trailATRMult = 1.0 + vol_pct
float scaleInR     = is_trending ? 0.25 : is_ranging ? 0.4 : 0.33

// ══════════════════════════════════════════════════════════════════════════════
// 8. SESSION BIAS + ORB
//
// All session-dependent logic uses the _eff_* variables resolved in §1b.
// When autoSession=ON these are auto-derived from syminfo.type.
// When autoSession=OFF these are the manual input values.
// ══════════════════════════════════════════════════════════════════════════════
bool newDay = ta.change(time("D")) != 0 or bar_index == 0

// inRTH: use _eff_use_session and _eff_session_hours
inRTH = not _eff_use_session or not na(time("1", _eff_session_hours))

// nz() doesn't support series bool in Pine v6 — ternary is required
bool _inRTH_prev = bar_index > 0 ? inRTH[1] : inRTH
bool sessionStart = (inRTH and not _inRTH_prev) or (newDay and not _eff_use_session)

// ★ Gate main signals on session — prevents signals outside RTH for futures/equity
// (matches strategy.pine sessionOK so tracker and strategy results align)
bool sessionOK = not _eff_use_session or inRTH

htTrend = request.security(syminfo.tickerid, htfTF,
     close > ta.ema(close, 9) ? 1 : -1, lookahead=barmerge.lookahead_off)

htf_ao = request.security(syminfo.tickerid, htfTF, ao, lookahead=barmerge.lookahead_off)

bullBias = biasMode == "Long Only" or
           (biasMode == "Auto" and
            (close > vwap ? 1 : 0) + (ao > 0 ? 1 : 0) + (htTrend == 1 ? 1 : 0) >= 2)

pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)

var float rHigh      = na
var float rLow       = na
var bool  rangeReady = false

bool _cross_hi_raw = ta.crossover (high, nz(rHigh, high))
bool _cross_lo_raw = ta.crossunder(low,  nz(rLow,  low))
bool cross_hi = not na(rHigh) and _cross_hi_raw
bool cross_lo = not na(rLow)  and _cross_lo_raw

if sessionStart
    rHigh      := na
    rLow       := na
    rangeReady := false

int barsSinceOpen = ta.barssince(sessionStart)

if barsSinceOpen * timeframe.multiplier <= orbMinutes and inRTH
    rHigh := math.max(nz(rHigh, high), high)
    rLow  := math.min(nz(rLow,  low),  low)
else if not rangeReady and not na(rHigh)
    rangeReady := true

orbBreakUp = rangeReady and cross_hi and     bullBias and barstate.isconfirmed
orbBreakDn = rangeReady and cross_lo and not bullBias and barstate.isconfirmed

// ORB window label: use _eff_orb_window (auto or manual)
bool orbWindow = not na(time("1", _eff_orb_window, syminfo.timezone))

var float ibHigh = na
var float ibLow  = na
var int   ibBars = 0
var bool  ibDone = false

if sessionStart
    ibHigh := high
    ibLow  := low
    ibBars := 0
    ibDone := false

if not ibDone and inRTH
    ibBars += 1
    ibHigh := math.max(ibHigh, high)
    ibLow  := math.min(ibLow,  low)
    if ibBars * timeframe.multiplier >= ibMinutes and barstate.isconfirmed
        ibDone := true

bb_u = ta.sma(close, 20) + 2.0 * ta.stdev(close, 20)
bb_l = ta.sma(close, 20) - 2.0 * ta.stdev(close, 20)
kc_u = ta.sma(close, 20) + ta.atr(20) * 1.5
kc_l = ta.sma(close, 20) - ta.atr(20) * 1.5
sqz_on    = bb_l > kc_l and bb_u < kc_u
sqz_fired = sqz_on[1] and not sqz_on

// ══════════════════════════════════════════════════════════════════════════════
// 9. QUALITY SCORE  (0 – 100)
// ══════════════════════════════════════════════════════════════════════════════
quality = 0.0
quality += (bullBias  and ao > ao[1])   or (not bullBias and ao < ao[1])         ? 20.0 : 0.0
quality += (close > ema9 and bullBias)  or (close < ema9 and not bullBias)       ? 15.0 : 0.0
quality += (bullBias  and close > vwap) or (not bullBias and close < vwap)       ? 20.0 : 0.0
quality += volume > volAvg * volMult                                               ? 25.0 : 0.0
quality += rangeReady and not na(rHigh) and not na(rLow) and
           ((bullBias and close > rHigh) or (not bullBias and close < rLow))       ? 20.0 : 0.0
quality := f_clamp(quality, 0.0, 100.0)

var float quality_confirmed = 0.0
if barstate.isconfirmed
    quality_confirmed := quality

// ══════════════════════════════════════════════════════════════════════════════
// 10. FILTER STACK + MAIN SIGNALS
// ══════════════════════════════════════════════════════════════════════════════
bool rsiOK_L    = rsi14 < rsiOBLevel
bool rsiOK_S    = rsi14 > rsiOSLevel
bool regimeOK_L = not suppressRegime or not is_trending_d
bool regimeOK_S = not suppressRegime or not is_trending_u
bool volOK      = volume > volAvg * volMult
bool vwapL      = not requireVWAP or (vwap_valid and close > vwap)
bool vwapS      = not requireVWAP or (vwap_valid and close < vwap)
bool qualOK     = quality >= minQualityPct
bool htfAO_L    = not useHTFAO or htf_ao > 0
bool htfAO_S    = not useHTFAO or htf_ao < 0

bool longSignal_raw  = strong_bot
     and  bullBias   and ao > 0  and volOK   and vwapL
     and qualOK      and rsiOK_L and waveOK_L and momOK_L
     and regimeOK_L  and htfAO_L and sessionOK and barstate.isconfirmed

bool shortSignal_raw = strong_top
     and not bullBias and ao < 0  and volOK   and vwapS
     and qualOK       and rsiOK_S and waveOK_S and momOK_S
     and regimeOK_S   and htfAO_S and sessionOK and barstate.isconfirmed

var int lastLong  = 0
var int lastShort = 0
bool longSignal  = longSignal_raw  and (bar_index - lastLong  > cooldownBars)
bool shortSignal = shortSignal_raw and (bar_index - lastShort > cooldownBars)

var bool last_signal_was_long = true

if longSignal
    lastLong             := bar_index
    last_signal_was_long := true
if shortSignal
    lastShort            := bar_index
    last_signal_was_long := false

var bool signal_bias = true
if longSignal
    signal_bias := true
if shortSignal
    signal_bias := false

// ══════════════════════════════════════════════════════════════════════════════
// 11. ENTRY · DYNAMIC SL · TP · SCALE-IN
// ══════════════════════════════════════════════════════════════════════════════
float _sl_base_mult = vol_pct >= 0.75 ? 2.0 :
                      vol_pct >= 0.55 ? 1.7 :
                      vol_pct >= 0.35 ? 1.4 : 1.2
float _vol_surge = slVolBoost and volume > volAvg * 2.5 ? 0.5 :
                   slVolBoost and volume > volAvg * 1.8 ? 0.25 : 0.0
float _sl_mult   = _sl_base_mult + _vol_surge

float _sweep_lo = ta.lowest (low,  sweepBars)
float _sweep_hi = ta.highest(high, sweepBars)

l_entry = close
l_sl    = dynSL ? math.min(_sweep_lo, close - atr14 * _sl_mult) - atr14 * 0.25 : low  - atr14
l_risk  = math.max(l_entry - l_sl, atr14 * 0.5)
l_tp1   = l_entry + l_risk * tp1R
l_tp2   = l_entry + l_risk * tp2R
l_tp3   = l_entry + l_risk * tp3R
l_e2    = l_entry - l_risk * scaleInR
l_e3    = l_entry - l_risk * scaleInR * 2.0

s_entry = close
s_sl    = dynSL ? math.max(_sweep_hi, close + atr14 * _sl_mult) + atr14 * 0.25 : high + atr14
s_risk  = math.max(s_sl - s_entry, atr14 * 0.5)
s_tp1   = s_entry - s_risk * tp1R
s_tp2   = s_entry - s_risk * tp2R
s_tp3   = s_entry - s_risk * tp3R
s_e2    = s_entry + s_risk * scaleInR
s_e3    = s_entry + s_risk * scaleInR * 2.0

// ══════════════════════════════════════════════════════════════════════════════
// 12. TRADE TRACKER
// ══════════════════════════════════════════════════════════════════════════════
var int lw      = 0
var int ll      = 0
var int sw      = 0
var int sl_c    = 0
var int rb_lw   = 0
var int rb_ll   = 0
var int rb_sw   = 0
var int rb_sl_c = 0

var bool  tl_active   = false
var bool  ts_active   = false
var float t_sl        = na
var float t_win_l     = na
var float t_win_s     = na
var bool  rb_l_active = false
var bool  rb_s_active = false
var float rb_sl_l     = na
var float rb_sl_s     = na
var float rb_win_l    = na
var float rb_win_s    = na

if resetOnDay and newDay
    lw          := 0
    ll          := 0
    sw          := 0
    sl_c        := 0
    rb_lw       := 0
    rb_ll       := 0
    rb_sw       := 0
    rb_sl_c     := 0
    tl_active   := false
    ts_active   := false
    rb_l_active := false
    rb_s_active := false

if longSignal and not tl_active and not ts_active
    tl_active := true
    t_sl      := l_sl
    t_win_l   := winTarget == "TP3" ? l_tp3 : winTarget == "TP2" ? l_tp2 : l_tp1

if shortSignal and not tl_active and not ts_active
    ts_active := true
    t_sl      := s_sl
    t_win_s   := winTarget == "TP3" ? s_tp3 : winTarget == "TP2" ? s_tp2 : s_tp1

bool _orbL_ok_trk = not filterORBQuality or (quality_confirmed >= minQualityPct and waveOK_L)
bool _orbS_ok_trk = not filterORBQuality or (quality_confirmed >= minQualityPct and waveOK_S)

if orbBreakUp and _orbL_ok_trk and not rb_l_active and not rb_s_active
    float _rbl_sl   = rLow - atr14
    float _rbl_risk = close - _rbl_sl
    rb_l_active := true
    rb_sl_l     := _rbl_sl
    rb_win_l    := winTarget == "TP3" ? close + _rbl_risk * tp3R :
                     winTarget == "TP2" ? close + _rbl_risk * tp2R :
                                         close + _rbl_risk * tp1R

if orbBreakDn and _orbS_ok_trk and not rb_l_active and not rb_s_active
    float _rbs_sl   = rHigh + atr14
    float _rbs_risk = _rbs_sl - close
    rb_s_active := true
    rb_sl_s     := _rbs_sl
    rb_win_s    := winTarget == "TP3" ? close - _rbs_risk * tp3R :
                     winTarget == "TP2" ? close - _rbs_risk * tp2R :
                                         close - _rbs_risk * tp1R

if tl_active and barstate.isconfirmed
    if low <= t_sl
        ll        += 1
        tl_active := false
    else if high >= t_win_l
        lw        += 1
        tl_active := false

if ts_active and barstate.isconfirmed
    if high >= t_sl
        sl_c      += 1
        ts_active := false
    else if low <= t_win_s
        sw        += 1
        ts_active := false

if rb_l_active and barstate.isconfirmed
    if low <= rb_sl_l
        rb_ll       += 1
        rb_l_active := false
    else if high >= rb_win_l
        rb_lw       += 1
        rb_l_active := false

if rb_s_active and barstate.isconfirmed
    if high >= rb_sl_s
        rb_sl_c     += 1
        rb_s_active := false
    else if low <= rb_win_s
        rb_sw       += 1
        rb_s_active := false

int   l_total    = lw      + ll
int   s_total    = sw      + sl_c
int   tg_total   = l_total + s_total
int   tg_wins    = lw      + sw
int   rb_l_total = rb_lw   + rb_ll
int   rb_s_total = rb_sw   + rb_sl_c
int   rb_total   = rb_l_total + rb_s_total
int   rb_wins    = rb_lw   + rb_sw
int   tot_long_w  = lw     + rb_lw
int   tot_long_l  = ll     + rb_ll
int   tot_short_w = sw     + rb_sw
int   tot_short_l = sl_c   + rb_sl_c
int   t_total     = tot_long_w + tot_long_l + tot_short_w + tot_short_l
int   tot_long_t  = tot_long_w  + tot_long_l
int   tot_short_t = tot_short_w + tot_short_l

float l_wr    = l_total    > 0 ? float(lw)        / float(l_total)    * 100 : 0.0
float s_wr    = s_total    > 0 ? float(sw)        / float(s_total)    * 100 : 0.0
float tg_wr   = tg_total   > 0 ? float(tg_wins)   / float(tg_total)   * 100 : 0.0
float rb_l_wr = rb_l_total > 0 ? float(rb_lw)     / float(rb_l_total) * 100 : 0.0
float rb_s_wr = rb_s_total > 0 ? float(rb_sw)     / float(rb_s_total) * 100 : 0.0
float rb_wr   = rb_total   > 0 ? float(rb_wins)   / float(rb_total)   * 100 : 0.0
float tot_wins  = float(tot_long_w) + float(tot_short_w)
float tot_wr    = t_total     > 0 ? tot_wins             / float(t_total)     * 100 : 0.0
float tot_l_wr  = tot_long_t  > 0 ? float(tot_long_w)   / float(tot_long_t)  * 100 : 0.0
float tot_s_wr  = tot_short_t > 0 ? float(tot_short_w)  / float(tot_short_t) * 100 : 0.0

string cur_tg_str = tl_active   ? "▲ TG LONG" : ts_active   ? "▼ TG SHORT" : "—"
string cur_rb_str = rb_l_active ? "▲ RB LONG" : rb_s_active ? "▼ RB SHORT" : "—"
color  cur_tg_col = tl_active   ? color.lime   : ts_active   ? color.red    : color.gray
color  cur_rb_col = rb_l_active ? color.lime   : rb_s_active ? color.red    : color.gray

// ══════════════════════════════════════════════════════════════════════════════
// 12b. VOLUME-HEAT BAR COLORING
// ══════════════════════════════════════════════════════════════════════════════
reg_line   = ta.linreg(hl2, topGLen, 0)
dev_series = close - reg_line
dev_std    = ta.stdev(dev_series, 200)
clvl       = dev_std == 0 ? 0.0 : dev_series / dev_std
clvl       := f_clamp(clvl, -5.0, 5.0)
heat_col   = clvl > 0
     ? color.from_gradient(clvl, 0,
          math.max(ta.highest(clvl, 70), 0.0001), color.yellow, color.red)
     : color.from_gradient(clvl,
          math.min(ta.lowest (clvl, 70), -0.0001), 0, color.aqua, color.yellow)
barcolor(useVolHeat ? heat_col : na, title = "Bar Volume Temperature")

// ══════════════════════════════════════════════════════════════════════════════
// 13. PLOTS
// ══════════════════════════════════════════════════════════════════════════════
pOrbHi = plot(rangeReady ? rHigh : na, "ORB High", color.new(#2962FF, 0), 2)
pOrbLo = plot(rangeReady ? rLow  : na, "ORB Low",  color.new(#2962FF, 0), 2)
fill(pOrbHi, pOrbLo, color.new(#2962FF, 85), title="ORB Zone")

plot(tg_hi,                 "TG Resistance", color.new(#ff1100, 50), 1, plot.style_linebr)
plot(tg_lo,                 "TG Support",    color.new(#00ffbb, 50), 1, plot.style_linebr)
plot(showMid ? tg_mid : na, "TG Mid",        color.new(color.gray, 75), 1, plot.style_linebr)
plot(showVWAP ? vwap : na,  "VWAP",          color.new(#FF00FF, 0), 2)
plot(showEMA9 ? ema9 : na,  "EMA9",          color.new(#00BFFF, 0), 2)
plot(pdHigh,                "PD High",       color.new(color.blue,   60), 1, plot.style_stepline)
plot(pdLow,                 "PD Low",        color.new(color.purple, 60), 1, plot.style_stepline)
plot(ibDone ? ibHigh : na,  "IB High",       color.new(color.aqua,   55), 1, plot.style_linebr)
plot(ibDone ? ibLow  : na,  "IB Low",        color.new(color.orange, 55), 1, plot.style_linebr)

bgcolor(close > ema9 and ao > 0 ? color.new(color.lime, 96) :
        close < ema9 and ao < 0 ? color.new(color.red,  96) : na)

if barstate.islast and tg_range > 0
    var box sup_box = box.new(bar_index[20], tg_lo + tg_range * 0.1, bar_index, tg_lo,
         bgcolor=color.new(color.teal, 88), border_color=color.new(color.green, 55))
    var box res_box = box.new(bar_index[20], tg_hi, bar_index, tg_hi - tg_range * 0.1,
         bgcolor=color.new(color.red,  90), border_color=color.new(color.red,   55))
    box.set_right( sup_box, bar_index)
    box.set_top(   sup_box, tg_lo + tg_range * 0.1)
    box.set_bottom(sup_box, tg_lo)
    box.set_right( res_box, bar_index)
    box.set_top(   res_box, tg_hi)
    box.set_bottom(res_box, tg_hi - tg_range * 0.1)

// ══════════════════════════════════════════════════════════════════════════════
// 14. AUTO BREAKOUT MARKERS
// ══════════════════════════════════════════════════════════════════════════════
plotshape(orbBreakUp  and     orbWindow, "ORB ↑",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.small, text="ORB")
plotshape(orbBreakUp  and not orbWindow, "RB ↑",   shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.small, text="RB")
plotshape(orbBreakDn  and     orbWindow, "ORB ↓",  shape.triangledown, location.abovebar, color.new(color.red,  0), size=size.small, text="ORB")
plotshape(orbBreakDn  and not orbWindow, "RB ↓",   shape.triangledown, location.abovebar, color.new(color.red,  0), size=size.small, text="RB")
plotshape(sqz_fired,           "Squeeze", shape.diamond, location.belowbar, color.new(color.yellow, 0), size=size.small, text="SQZ")

plotshape(showTGDots     and strong_bot, "TG Bounce",            shape.circle,  location.belowbar, color.new(#00ffbb,  0), size=size.normal)
plotshape(showTGDots     and strong_top, "TG Rejection",         shape.circle,  location.abovebar, color.new(#ff1100,  0), size=size.normal)
plotshape(showSimpleDots and simple_bot, "TG Simple Support",    shape.circle,  location.belowbar, color.new(#00ffbb, 50), size=size.small)
plotshape(showSimpleDots and simple_top, "TG Simple Resistance", shape.circle,  location.abovebar, color.new(#ff1100, 50), size=size.small)
plotshape(showPotDots    and pot_bot,    "TG Potential Support", shape.diamond, location.belowbar, color.new(#00ffbb, 70), size=size.tiny)
plotshape(showPotDots    and pot_top,    "TG Potential Resist",  shape.diamond, location.abovebar, color.new(#ff1100, 70), size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// 15. SIGNAL SHAPES + LABELS
// ══════════════════════════════════════════════════════════════════════════════
plotshape(longSignal,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.large)
plotshape(shortSignal, "Short", shape.triangledown, location.abovebar, color.new(color.red,   0), size=size.large)

var array<line> l_sig_lines   = array.new<line>()
var array<line> s_sig_lines   = array.new<line>()
var array<line> l_bo_lines    = array.new<line>()
var array<line> s_bo_lines    = array.new<line>()
var array<line> l_scale_lines = array.new<line>()
var array<line> s_scale_lines = array.new<line>()

var int   daily_label_count = 0
var int   last_rbl_bar      = 0
var float last_rbl_price    = na
var int   last_rbs_bar      = 0
var float last_rbs_price    = na

if sessionStart
    daily_label_count := 0
    last_rbl_bar      := 0
    last_rbl_price    := na
    last_rbs_bar      := 0
    last_rbs_price    := na

var bool  trail_l_on     = false
var bool  trail_s_on     = false
var float trail_l_peak   = na
var float trail_s_trough = na
var float trail_l_stop   = na
var float trail_s_stop   = na
var line  trail_l_line   = na
var line  trail_s_line   = na

if longSignal
    trail_l_on     := true
    trail_s_on     := false
    trail_l_peak   := high
    trail_l_stop   := high - atr14 * trailATRMult

if shortSignal
    trail_s_on     := true
    trail_l_on     := false
    trail_s_trough := low
    trail_s_stop   := low + atr14 * trailATRMult

if trail_l_on and barstate.isconfirmed
    if high > trail_l_peak
        trail_l_peak := high
        trail_l_stop := trail_l_peak - atr14 * trailATRMult
    if low <= trail_l_stop
        trail_l_on := false

if trail_s_on and barstate.isconfirmed
    if low < trail_s_trough
        trail_s_trough := low
        trail_s_stop   := trail_s_trough + atr14 * trailATRMult
    if high >= trail_s_stop
        trail_s_on := false

if showTrail and barstate.islast
    line.delete(trail_l_line)
    line.delete(trail_s_line)
    trail_l_line := na
    trail_s_line := na
    if trail_l_on
        trail_l_line := line.new(bar_index - 1, trail_l_stop, bar_index + 15, trail_l_stop,
             color=color.new(color.yellow, 20), style=line.style_dotted, width=2)
    if trail_s_on
        trail_s_line := line.new(bar_index - 1, trail_s_stop, bar_index + 15, trail_s_stop,
             color=color.new(color.yellow, 20), style=line.style_dotted, width=2)

if showEntryLabels
    if longSignal
        f_label_new(bar_index, low - atr14 * 0.6,
             "▲  " + str.tostring(l_entry, format.mintick) +
             "   ✗" + str.tostring(l_sl,   format.mintick) +
             "   ✓" + str.tostring(l_tp1,  format.mintick),
             color.new(color.green, 15), label.style_label_up, color.white, size.small)
    if shortSignal
        f_label_new(bar_index, high + atr14 * 0.6,
             "▼  " + str.tostring(s_entry, format.mintick) +
             "   ✗" + str.tostring(s_sl,   format.mintick) +
             "   ✓" + str.tostring(s_tp1,  format.mintick),
             color.new(color.red, 15), label.style_label_down, color.white, size.small)

if longSignal
    int _n = array.size(l_sig_lines)
    if _n > 0
        for _i = 0 to _n - 1
            line.delete(array.get(l_sig_lines, _i))
    array.clear(l_sig_lines)
    array.push(l_sig_lines, line.new(bar_index, l_tp1, bar_index+30, l_tp1, color=color.new(color.lime,  20), style=line.style_solid,  width=2))
    array.push(l_sig_lines, line.new(bar_index, l_tp2, bar_index+30, l_tp2, color=color.new(color.green, 35), style=line.style_dashed, width=1))
    array.push(l_sig_lines, line.new(bar_index, l_tp3, bar_index+30, l_tp3, color=color.new(color.teal,  45), style=line.style_dashed, width=1))
    array.push(l_sig_lines, line.new(bar_index, l_sl,  bar_index+30, l_sl,  color=color.new(color.red,   20), style=line.style_solid,  width=2))
    f_label_new(bar_index+30, l_tp1, str.tostring(l_tp1, format.mintick), color.new(color.lime, 20), label.style_label_left, color.white, size.tiny)
    f_label_new(bar_index+30, l_sl,  str.tostring(l_sl,  format.mintick), color.new(color.red,  20), label.style_label_left, color.white, size.tiny)
    if showScaleIn
        int _ls = array.size(l_scale_lines)
        if _ls > 0
            for _i = 0 to _ls - 1
                line.delete(array.get(l_scale_lines, _i))
        array.clear(l_scale_lines)
        array.push(l_scale_lines, line.new(bar_index, l_e2, bar_index+20, l_e2, color=color.new(color.aqua, 40), style=line.style_dashed))
        array.push(l_scale_lines, line.new(bar_index, l_e3, bar_index+20, l_e3, color=color.new(color.aqua, 55), style=line.style_dashed))
        f_label_new(bar_index, l_e2, "E2", color.new(color.aqua, 30), label.style_label_right, color.white, size.tiny)
        f_label_new(bar_index, l_e3, "E3", color.new(color.aqua, 45), label.style_label_right, color.white, size.tiny)

if shortSignal
    int _n = array.size(s_sig_lines)
    if _n > 0
        for _i = 0 to _n - 1
            line.delete(array.get(s_sig_lines, _i))
    array.clear(s_sig_lines)
    array.push(s_sig_lines, line.new(bar_index, s_tp1, bar_index+30, s_tp1, color=color.new(color.red,    20), style=line.style_solid,  width=2))
    array.push(s_sig_lines, line.new(bar_index, s_tp2, bar_index+30, s_tp2, color=color.new(color.orange, 35), style=line.style_dashed, width=1))
    array.push(s_sig_lines, line.new(bar_index, s_tp3, bar_index+30, s_tp3, color=color.new(color.maroon, 45), style=line.style_dashed, width=1))
    array.push(s_sig_lines, line.new(bar_index, s_sl,  bar_index+30, s_sl,  color=color.new(color.lime,   20), style=line.style_solid,  width=2))
    f_label_new(bar_index+30, s_tp1, str.tostring(s_tp1, format.mintick), color.new(color.red,  20), label.style_label_left, color.white, size.tiny)
    f_label_new(bar_index+30, s_sl,  str.tostring(s_sl,  format.mintick), color.new(color.lime, 20), label.style_label_left, color.white, size.tiny)
    if showScaleIn
        int _ss = array.size(s_scale_lines)
        if _ss > 0
            for _i = 0 to _ss - 1
                line.delete(array.get(s_scale_lines, _i))
        array.clear(s_scale_lines)
        array.push(s_scale_lines, line.new(bar_index, s_e2, bar_index+20, s_e2, color=color.new(color.fuchsia, 40), style=line.style_dashed))
        array.push(s_scale_lines, line.new(bar_index, s_e3, bar_index+20, s_e3, color=color.new(color.fuchsia, 55), style=line.style_dashed))
        f_label_new(bar_index, s_e2, "E2", color.new(color.fuchsia, 30), label.style_label_right, color.white, size.tiny)
        f_label_new(bar_index, s_e3, "E3", color.new(color.fuchsia, 45), label.style_label_right, color.white, size.tiny)

if showBreakoutLabels
    bool _orbL_ok     = not filterORBQuality or (quality_confirmed >= minQualityPct and waveOK_L)
    bool _orbS_ok     = not filterORBQuality or (quality_confirmed >= minQualityPct and waveOK_S)
    bool _rbl_dist_ok = na(last_rbl_price) or math.abs(close - last_rbl_price) > atr14 * minLabelDistATR or bar_index - last_rbl_bar > cooldownBars * 2
    bool _rbs_dist_ok = na(last_rbs_price) or math.abs(close - last_rbs_price) > atr14 * minLabelDistATR or bar_index - last_rbs_bar > cooldownBars * 2

    if orbBreakUp and _orbL_ok and _rbl_dist_ok and daily_label_count < maxLabelsDay
        float _bo_sl   = rLow - atr14
        float _bo_risk = close - _bo_sl
        string _bo_tag = orbWindow ? "LONG ORB 🚀" : "LONG RB 🚀"
        int _n = array.size(l_bo_lines)
        if _n > 0
            for _i = 0 to _n - 1
                line.delete(array.get(l_bo_lines, _i))
        array.clear(l_bo_lines)
        f_label_new(bar_index, low - atr14 * 1.8,
             _bo_tag +
             "\nEntry : " + str.tostring(close,                    format.mintick) +
             "\nSL    : " + str.tostring(_bo_sl,                   format.mintick) +
             "\nTP 1  : " + str.tostring(close + _bo_risk * tp1R,  format.mintick) + "  (" + str.tostring(tp1R, "#.##") + "R)" +
             "\nTP 2  : " + str.tostring(close + _bo_risk * tp2R,  format.mintick) + "  (" + str.tostring(tp2R, "#.##") + "R)" +
             "\nQual  : " + str.tostring(math.round(quality_confirmed)) + "%",
             color.new(color.green, 20), label.style_label_up, color.white, size.normal)
        array.push(l_bo_lines, line.new(bar_index, close + _bo_risk * tp1R, bar_index+20, close + _bo_risk * tp1R, color=color.new(color.lime,  40), style=line.style_dashed))
        array.push(l_bo_lines, line.new(bar_index, close + _bo_risk * tp2R, bar_index+20, close + _bo_risk * tp2R, color=color.new(color.green, 40), style=line.style_dashed))
        array.push(l_bo_lines, line.new(bar_index, _bo_sl,                  bar_index+20, _bo_sl,                  color=color.new(color.red,   50), style=line.style_dashed))
        last_rbl_bar      := bar_index
        last_rbl_price    := close
        daily_label_count += 1

    if orbBreakDn and _orbS_ok and _rbs_dist_ok and daily_label_count < maxLabelsDay
        float _bo_sl   = rHigh + atr14
        float _bo_risk = _bo_sl - close
        string _bo_tag = orbWindow ? "SHORT ORB 📉" : "SHORT RB 📉"
        int _n = array.size(s_bo_lines)
        if _n > 0
            for _i = 0 to _n - 1
                line.delete(array.get(s_bo_lines, _i))
        array.clear(s_bo_lines)
        f_label_new(bar_index, high + atr14 * 1.8,
             _bo_tag +
             "\nEntry : " + str.tostring(close,                    format.mintick) +
             "\nSL    : " + str.tostring(_bo_sl,                   format.mintick) +
             "\nTP 1  : " + str.tostring(close - _bo_risk * tp1R,  format.mintick) + "  (" + str.tostring(tp1R, "#.##") + "R)" +
             "\nTP 2  : " + str.tostring(close - _bo_risk * tp2R,  format.mintick) + "  (" + str.tostring(tp2R, "#.##") + "R)" +
             "\nQual  : " + str.tostring(math.round(quality_confirmed)) + "%",
             color.new(color.red, 20), label.style_label_down, color.white, size.normal)
        array.push(s_bo_lines, line.new(bar_index, close - _bo_risk * tp1R, bar_index+20, close - _bo_risk * tp1R, color=color.new(color.red,    40), style=line.style_dashed))
        array.push(s_bo_lines, line.new(bar_index, close - _bo_risk * tp2R, bar_index+20, close - _bo_risk * tp2R, color=color.new(color.orange, 40), style=line.style_dashed))
        array.push(s_bo_lines, line.new(bar_index, _bo_sl,                  bar_index+20, _bo_sl,                  color=color.new(color.lime,   50), style=line.style_dashed))
        last_rbs_bar      := bar_index
        last_rbs_price    := close
        daily_label_count += 1

// ══════════════════════════════════════════════════════════════════════════════
// 16. DASHBOARD
// Adaptive row (row 2) cells 13-15 show:
//   13 → detected asset type
//   14 → session mode (auto/manual)
//   15 → effective RTH session string in use
// ══════════════════════════════════════════════════════════════════════════════
_pos = dashPos_str == "Bottom Right" ? position.bottom_right :
       dashPos_str == "Top Left"     ? position.top_left     :
       dashPos_str == "Bottom Left"  ? position.bottom_left  : position.top_right

var table dash = table.new(_pos, 19, 3,
     bgcolor=color.new(#1e222d, 85), border_width=1, frame_color=#00ffff)

if barstate.islast and showDash
    table.cell(dash, 0, 0, "RUBY",         text_color=#00ffff,    text_size=size.normal)
    table.cell(dash, 0, 1, syminfo.ticker, text_color=color.gray, text_size=size.normal)

    _rc = market_regime == "TRENDING ↑" ? color.lime :
          market_regime == "TRENDING ↓" ? color.red  :
          market_regime == "VOLATILE"   ? color.orange : color.gray
    table.cell(dash, 1, 0, "Regime",      text_color=color.gray, text_size=size.normal)
    table.cell(dash, 1, 1, market_regime, text_color=_rc,        text_size=size.normal)

    table.cell(dash, 2, 0, "Phase",      text_color=color.gray, text_size=size.normal)
    table.cell(dash, 2, 1, market_phase, text_color=phase_col,  text_size=size.normal)

    table.cell(dash, 3, 0, "Bias",       text_color=color.gray, text_size=size.normal)
    table.cell(dash, 3, 1, bullBias ? "BULL ↑" : "BEAR ↓",
         text_color=bullBias ? color.lime : color.red, text_size=size.normal)

    table.cell(dash, 4, 0, "Quality",    text_color=color.gray, text_size=size.normal)
    table.cell(dash, 4, 1, str.tostring(math.round(quality_confirmed)) + "% / " + str.tostring(math.round(minQualityPct)) + "▸",
         text_color=quality_confirmed >= minQualityPct ? color.lime : color.red, text_size=size.normal)

    table.cell(dash, 5, 0, "Wave",       text_color=color.gray, text_size=size.normal)
    table.cell(dash, 5, 1,
         (mkt_bias == "Bullish" ? "↑ " : "↓ ") + str.tostring(math.round(wave_ratio, 2)) + "x  p" + str.tostring(math.round(wr_pct * 100)) + "%",
         text_color=mkt_bias == "Bullish" ? color.lime : color.red, text_size=size.normal)

    table.cell(dash, 6, 0, "Mom",        text_color=color.gray, text_size=size.normal)
    table.cell(dash, 6, 1, str.tostring(math.round(math.abs(cur_ratio), 2)) + "x  p" + str.tostring(math.round(mom_pct * 100)) + "%",
         text_color=cur_ratio >= 0 ? color.lime : color.red, text_size=size.normal)

    table.cell(dash, 7, 0, "AO",         text_color=color.gray, text_size=size.normal)
    table.cell(dash, 7, 1, str.tostring(ao, "#.####"),
         text_color=ao > 0 ? color.lime : color.red, text_size=size.normal)

    table.cell(dash, 8, 0, "VWAP",       text_color=color.gray, text_size=size.normal)
    table.cell(dash, 8, 1,
         (vwap_valid ? "" : "~") + str.tostring(vwap, format.mintick),
         text_color=vwap_valid ? #FF00FF : color.orange, text_size=size.normal)

    table.cell(dash, 9, 0, "Volume",     text_color=color.gray, text_size=size.normal)
    table.cell(dash, 9, 1, str.tostring(volume / volAvg, "0.00") + "×  ▸" + str.tostring(volMult, "#.##") + "×",
         text_color=volume > volAvg * volMult ? color.lime : color.gray, text_size=size.normal)

    _vc = vol_pct >= 0.8 ? color.red : vol_pct >= 0.6 ? color.orange :
          vol_pct <= 0.2 ? color.blue : color.lime
    table.cell(dash, 10, 0, "Volat.",    text_color=color.gray, text_size=size.normal)
    table.cell(dash, 10, 1, vol_regime + " " + str.tostring(math.round(vol_pct * 100)) + "%",
         text_color=_vc, text_size=size.normal)

    table.cell(dash, 11, 0, "TG Chan",   text_color=color.gray, text_size=size.normal)
    table.cell(dash, 11, 1, str.tostring(tg_hi, format.mintick) + "/" + str.tostring(tg_lo, format.mintick),
         text_color=color.white, text_size=size.normal)

    _ts = strong_bot ? "⬆ BOUNCE" : strong_top ? "⬇ REJECT" :
          simple_bot ? "^ touch"  : simple_top ? "˅ touch"  : "—"
    _tc = strong_bot or simple_bot ? color.lime : strong_top or simple_top ? color.red : color.gray
    table.cell(dash, 12, 0, "TG Sig",    text_color=color.gray, text_size=size.normal)
    table.cell(dash, 12, 1, _ts,         text_color=_tc,        text_size=size.normal)

    table.cell(dash, 13, 0, "ORB",       text_color=color.gray, text_size=size.normal)
    table.cell(dash, 13, 1,
         rangeReady ? str.tostring(rHigh, format.mintick) + "/" + str.tostring(rLow, format.mintick) : "BUILDING",
         text_color=#2962FF, text_size=size.normal)

    table.cell(dash, 14, 0, "Squeeze",   text_color=color.gray, text_size=size.normal)
    table.cell(dash, 14, 1,
         sqz_on ? "💥 ON" : sqz_fired ? "🔥 FIRED" : "—",
         text_color=sqz_on ? color.yellow : sqz_fired ? color.lime : color.gray,
         text_size=size.normal)

    table.cell(dash, 15, 0, "RSI",       text_color=color.gray, text_size=size.normal)
    bool _rsi_ok = bullBias ? rsiOK_L : rsiOK_S
    table.cell(dash, 15, 1, str.tostring(math.round(rsi14)) + "  ▸" +
         str.tostring(bullBias ? math.round(rsiOBLevel) : math.round(rsiOSLevel)) + (_rsi_ok ? " ✓" : " ✗"),
         text_color=rsi14 > rsiOBLevel ? color.red : rsi14 < rsiOSLevel ? color.lime : color.gray,
         text_size=size.normal)

    int _last_sig_bar = last_signal_was_long ? lastLong : lastShort
    int _cd_rem       = math.max(0, cooldownBars - (bar_index - _last_sig_bar))
    table.cell(dash, 16, 0, "CD",        text_color=color.gray, text_size=size.normal)
    table.cell(dash, 16, 1, (_cd_rem > 0 ? str.tostring(_cd_rem) + "b" : "READY") + " / " + str.tostring(cooldownBars),
         text_color=_cd_rem > 0 ? color.orange : color.lime, text_size=size.normal)

    table.cell(dash, 17, 0, "TP1",       text_color=color.gray, text_size=size.normal)
    table.cell(dash, 17, 1, str.tostring(tp1R, "#.##") + "R",
         text_color=color.yellow, text_size=size.normal)

    _sl_sig = longSignal ? "▲ LONG" : shortSignal ? "▼ SHORT" : "—"
    _sc_sig = longSignal ? color.lime : shortSignal ? color.red : color.gray
    table.cell(dash, 18, 0, "Signal",    text_color=color.gray, text_size=size.normal)
    table.cell(dash, 18, 1, _sl_sig,     text_color=_sc_sig,    text_size=size.normal)

    // Row 2 — live adaptive values
    table.cell(dash,  0, 2, "ADAPTIVE",  text_color=color.new(#00ffff, 40), text_size=size.small)
    table.cell(dash,  1, 2, "vol×" + str.tostring(volMult, "#.#"),                              text_color=color.gray, text_size=size.small)
    table.cell(dash,  2, 2, "q≥"   + str.tostring(math.round(minQualityPct)),                   text_color=color.gray, text_size=size.small)
    table.cell(dash,  3, 2, "cd="  + str.tostring(cooldownBars),                                text_color=color.gray, text_size=size.small)
    table.cell(dash,  4, 2, "tp1=" + str.tostring(tp1R, "#.##"),                                text_color=color.gray, text_size=size.small)
    table.cell(dash,  5, 2, "tp2=" + str.tostring(tp2R, "#.##"),                                text_color=color.gray, text_size=size.small)
    table.cell(dash,  6, 2, "tp3=" + str.tostring(tp3R, "#.##"),                                text_color=color.gray, text_size=size.small)
    table.cell(dash,  7, 2, "trail=" + str.tostring(trailATRMult, "#.#") + "a",                 text_color=color.gray, text_size=size.small)
    table.cell(dash,  8, 2, "sclIn=" + str.tostring(scaleInR, "#.##"),                          text_color=color.gray, text_size=size.small)
    table.cell(dash,  9, 2, "wrPct=" + str.tostring(math.round(wr_pct  * 100)) + "%",           text_color=color.gray, text_size=size.small)
    table.cell(dash, 10, 2, "mPct="  + str.tostring(math.round(mom_pct * 100)) + "%",           text_color=color.gray, text_size=size.small)
    table.cell(dash, 11, 2,
         useHTFAO ? ("htfAO=" + (htf_ao > 0 ? "↑" : "↓")) : "htfAO=off",
         text_color=useHTFAO ? (htf_ao > 0 ? color.lime : color.red) : color.gray,
         text_size=size.small)
    table.cell(dash, 12, 2,
         "e.bias=" + (signal_bias ? "L" : "S"),
         text_color=signal_bias ? color.lime : color.red,
         text_size=size.small)
    table.cell(dash, 13, 2, asset_type_label,
         text_color=_type_crypto ? color.orange :
                    _type_forex  ? color.yellow :
                    _type_futures? color.aqua   :
                    _type_equity ? color.lime   : color.gray,
         text_size=size.small)
    table.cell(dash, 14, 2, autoSession ? "sess=auto" : "sess=man",
         text_color=autoSession ? color.lime : color.yellow, text_size=size.small)
    table.cell(dash, 15, 2, _eff_session_hours,
         text_color=color.gray, text_size=size.small)
    table.cell(dash, 16, 2, "", text_color=color.gray, text_size=size.small)
    table.cell(dash, 17, 2, "", text_color=color.gray, text_size=size.small)
    table.cell(dash, 18, 2, "", text_color=color.gray, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// 17. TRADE TRACKER TABLE
// ══════════════════════════════════════════════════════════════════════════════
_tp = trackerPos_str == "Bottom Right" ? position.bottom_right :
      trackerPos_str == "Top Left"     ? position.top_left     :
      trackerPos_str == "Bottom Left"  ? position.bottom_left  : position.top_right

var table trk = table.new(_tp, 6, 7,
     bgcolor=color.new(#1e222d, 88), border_width=1, frame_color=#00ffff)

if barstate.islast and showTracker
    table.cell(trk, 0, 0, "TRACKER", text_color=#00ffff,     text_size=size.normal)
    table.cell(trk, 1, 0, "L-W",     text_color=color.lime,  text_size=size.normal)
    table.cell(trk, 2, 0, "L-L",     text_color=color.red,   text_size=size.normal)
    table.cell(trk, 3, 0, "S-W",     text_color=color.lime,  text_size=size.normal)
    table.cell(trk, 4, 0, "S-L",     text_color=color.red,   text_size=size.normal)
    table.cell(trk, 5, 0, "Win%",    text_color=color.white, text_size=size.normal)

    table.cell(trk, 0, 1, "TG",      text_color=#00ffbb, text_size=size.normal)
    table.cell(trk, 1, 1, str.tostring(lw),   text_color=lw   > 0 ? color.lime : color.gray, text_size=size.normal)
    table.cell(trk, 2, 1, str.tostring(ll),   text_color=ll   > 0 ? color.red  : color.gray, text_size=size.normal)
    table.cell(trk, 3, 1, str.tostring(sw),   text_color=sw   > 0 ? color.lime : color.gray, text_size=size.normal)
    table.cell(trk, 4, 1, str.tostring(sl_c), text_color=sl_c > 0 ? color.red  : color.gray, text_size=size.normal)
    _tgwr_c = tg_wr >= 55 ? color.lime : tg_wr >= 40 ? color.yellow : tg_total > 0 ? color.red : color.gray
    table.cell(trk, 5, 1, tg_total > 0 ? str.tostring(math.round(tg_wr)) + "%" : "—", text_color=_tgwr_c, text_size=size.normal)

    table.cell(trk, 0, 2, "RB/ORB",  text_color=#2962FF, text_size=size.normal)
    table.cell(trk, 1, 2, str.tostring(rb_lw),   text_color=rb_lw   > 0 ? color.lime : color.gray, text_size=size.normal)
    table.cell(trk, 2, 2, str.tostring(rb_ll),   text_color=rb_ll   > 0 ? color.red  : color.gray, text_size=size.normal)
    table.cell(trk, 3, 2, str.tostring(rb_sw),   text_color=rb_sw   > 0 ? color.lime : color.gray, text_size=size.normal)
    table.cell(trk, 4, 2, str.tostring(rb_sl_c), text_color=rb_sl_c > 0 ? color.red  : color.gray, text_size=size.normal)
    _rbwr_c = rb_wr >= 55 ? color.lime : rb_wr >= 40 ? color.yellow : rb_total > 0 ? color.red : color.gray
    table.cell(trk, 5, 2, rb_total > 0 ? str.tostring(math.round(rb_wr)) + "%" : "—", text_color=_rbwr_c, text_size=size.normal)

    table.cell(trk, 0, 3, "ALL",     text_color=color.white, text_size=size.normal)
    table.cell(trk, 1, 3, str.tostring(tot_long_w),  text_color=tot_long_w  > 0 ? color.lime : color.gray, text_size=size.normal)
    table.cell(trk, 2, 3, str.tostring(tot_long_l),  text_color=tot_long_l  > 0 ? color.red  : color.gray, text_size=size.normal)
    table.cell(trk, 3, 3, str.tostring(tot_short_w), text_color=tot_short_w > 0 ? color.lime : color.gray, text_size=size.normal)
    table.cell(trk, 4, 3, str.tostring(tot_short_l), text_color=tot_short_l > 0 ? color.red  : color.gray, text_size=size.normal)
    _totwr_c = tot_wr >= 55 ? color.lime : tot_wr >= 40 ? color.yellow : t_total > 0 ? color.red : color.gray
    table.cell(trk, 5, 3, t_total > 0 ? str.tostring(math.round(tot_wr)) + "%" : "—", text_color=_totwr_c, text_size=size.normal)

    table.cell(trk, 0, 4, "L Win%",  text_color=color.gray, text_size=size.normal)
    _lwc_tg = l_wr    >= 55 ? color.lime : l_wr    >= 40 ? color.yellow : l_total    > 0 ? color.red : color.gray
    _lwc_rb = rb_l_wr >= 55 ? color.lime : rb_l_wr >= 40 ? color.yellow : rb_l_total > 0 ? color.red : color.gray
    _lwc_al = tot_l_wr>= 55 ? color.lime : tot_l_wr>= 40 ? color.yellow : tot_long_t > 0 ? color.red : color.gray
    table.cell(trk, 1, 4, l_total    > 0 ? str.tostring(math.round(l_wr))    + "%" : "—", text_color=_lwc_tg, text_size=size.normal)
    table.cell(trk, 2, 4, rb_l_total > 0 ? str.tostring(math.round(rb_l_wr)) + "%" : "—", text_color=_lwc_rb, text_size=size.normal)
    table.cell(trk, 3, 4, str.tostring(t_total) + " tr", text_color=color.gray, text_size=size.normal)
    table.cell(trk, 4, 4, tot_long_t > 0 ? str.tostring(math.round(tot_l_wr)) + "%" : "—", text_color=_lwc_al, text_size=size.normal)
    table.cell(trk, 5, 4, cur_tg_str, text_color=cur_tg_col, text_size=size.normal)

    table.cell(trk, 0, 5, "S Win%",   text_color=color.gray, text_size=size.normal)
    _swc_tg = s_wr    >= 55 ? color.lime : s_wr    >= 40 ? color.yellow : s_total    > 0 ? color.red : color.gray
    _swc_rb = rb_s_wr >= 55 ? color.lime : rb_s_wr >= 40 ? color.yellow : rb_s_total > 0 ? color.red : color.gray
    _swc_al = tot_s_wr>= 55 ? color.lime : tot_s_wr>= 40 ? color.yellow : tot_short_t> 0 ? color.red : color.gray
    table.cell(trk, 1, 5, s_total    > 0 ? str.tostring(math.round(s_wr))    + "%" : "—", text_color=_swc_tg, text_size=size.normal)
    table.cell(trk, 2, 5, rb_s_total > 0 ? str.tostring(math.round(rb_s_wr)) + "%" : "—", text_color=_swc_rb, text_size=size.normal)
    table.cell(trk, 3, 5, "Win=" + winTarget, text_color=color.gray, text_size=size.normal)
    table.cell(trk, 4, 5, tot_short_t > 0 ? str.tostring(math.round(tot_s_wr)) + "%" : "—", text_color=_swc_al, text_size=size.normal)
    table.cell(trk, 5, 5, cur_rb_str, text_color=cur_rb_col, text_size=size.normal)

    table.cell(trk, 0, 6, "Edge",     text_color=color.gray, text_size=size.normal)
    string _l_edge = tot_long_t  >= 3 ? (tot_l_wr >= 55 ? "✓ LONG"  : tot_l_wr < 40 ? "✗ LONG"  : "~ LONG")  : "—"
    string _s_edge = tot_short_t >= 3 ? (tot_s_wr >= 55 ? "✓ SHORT" : tot_s_wr < 40 ? "✗ SHORT" : "~ SHORT") : "—"
    color  _l_ec   = tot_l_wr >= 55 ? color.lime : tot_l_wr < 40 and tot_long_t  >= 3 ? color.red : color.gray
    color  _s_ec   = tot_s_wr >= 55 ? color.lime : tot_s_wr < 40 and tot_short_t >= 3 ? color.red : color.gray
    table.cell(trk, 1, 6, _l_edge, text_color=_l_ec, text_size=size.normal)
    table.cell(trk, 2, 6, _s_edge, text_color=_s_ec, text_size=size.normal)
    string _bias_rec = t_total >= 5 ? (tot_l_wr > tot_s_wr + 15 ? "▲ LONGS" : tot_s_wr > tot_l_wr + 15 ? "▼ SHORTS" : "= BALANCED") : "5+ needed"
    color  _bias_col = t_total >= 5 ? (tot_l_wr > tot_s_wr + 15 ? color.lime : tot_s_wr > tot_l_wr + 15 ? color.red : color.yellow) : color.gray
    table.cell(trk, 3, 6, _bias_rec, text_color=_bias_col, text_size=size.normal)
    table.cell(trk, 4, 6, "",         text_color=color.gray, text_size=size.normal)
    table.cell(trk, 5, 6, resetOnDay ? "Daily" : "All-time", text_color=color.gray, text_size=size.normal)

// ══════════════════════════════════════════════════════════════════════════════
// 18. ALERTS
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(longSignal,                   "Ruby Long",      "{{ticker}} {{interval}} 📈 RUBY LONG")
alertcondition(shortSignal,                  "Ruby Short",     "{{ticker}} {{interval}} 📉 RUBY SHORT")
alertcondition(longSignal or shortSignal,    "Ruby Signal",    "{{ticker}} {{interval}} Ruby signal fired")
alertcondition(orbBreakUp,                   "ORB Break Up",   "{{ticker}} {{interval}} 🚀 ORB Breakout UP")
alertcondition(orbBreakDn,                   "ORB Break Down", "{{ticker}} {{interval}} 📉 ORB Breakout DOWN")
alertcondition(sqz_fired,                    "Squeeze Fired",  "{{ticker}} {{interval}} 💥 Squeeze FIRED")
alertcondition(strong_bot,                   "TG Bounce",      "{{ticker}} {{interval}} TG Strong Bounce")
alertcondition(strong_top,                   "TG Rejection",   "{{ticker}} {{interval}} TG Strong Rejection")
alertcondition(strong_bot or orbBreakUp,     "Long Setup",     "{{ticker}} {{interval}} 📈 Long Setup")
alertcondition(strong_top or orbBreakDn,     "Short Setup",    "{{ticker}} {{interval}} 📉 Short Setup")

alertcondition(tl_active[1] and not tl_active and lw > lw[1],        "TG Long TP Hit",    "{{ticker}} {{interval}} ✅ TG Long TP Hit")
alertcondition(tl_active[1] and not tl_active and ll > ll[1],        "TG Long SL Hit",    "{{ticker}} {{interval}} ❌ TG Long SL Hit")
alertcondition(ts_active[1] and not ts_active and sw > sw[1],        "TG Short TP Hit",   "{{ticker}} {{interval}} ✅ TG Short TP Hit")
alertcondition(ts_active[1] and not ts_active and sl_c > sl_c[1],    "TG Short SL Hit",   "{{ticker}} {{interval}} ❌ TG Short SL Hit")
alertcondition(rb_l_active[1] and not rb_l_active and rb_lw > rb_lw[1],     "RB Long TP Hit",    "{{ticker}} {{interval}} ✅ RB Long TP Hit")
alertcondition(rb_l_active[1] and not rb_l_active and rb_ll > rb_ll[1],     "RB Long SL Hit",    "{{ticker}} {{interval}} ❌ RB Long SL Hit")
alertcondition(rb_s_active[1] and not rb_s_active and rb_sw > rb_sw[1],     "RB Short TP Hit",   "{{ticker}} {{interval}} ✅ RB Short TP Hit")
alertcondition(rb_s_active[1] and not rb_s_active and rb_sl_c > rb_sl_c[1], "RB Short SL Hit",   "{{ticker}} {{interval}} ❌ RB Short SL Hit")
